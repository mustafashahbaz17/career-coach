            },
            {
              "fieldId": "error_message",
              "fieldValue": "={{ $('Write email').item.json.ai_error }}"
            }
          ]
        }
      },
      "id": "49dda7fe-ab28-47e7-bf2a-8259dc61c334",
      "name": "Log AI run",
