        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"matches\": {\n      \"type\": \"array\",\n      \"description\": \"Exactly the number of opportunities asked for, best fit first\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"candidate\": {\n            \"type\": \"integer\",\n            \"description\": \"The opportunity's number from the list\"\n          },\n          \"fit_score\": {\n            \"type\": \"integer\",\n            \"description\": \"0 to 100\"\n          },\n          \"why_you_qualify\": {\n            \"type\": \"string\",\n            \"description\": \"1-2 sentences, at most 35 words, specific to this student\"\n          },\n          \"what_you_are_missing\": {\n            \"type\": \"string\",\n            \"description\": \"One concrete gap, at most 20 words, or empty\"\n          }\n        },\n        \"required\": [\n          \"candidate\",\n          \"fit_score\",\n          \"why_you_qualify\",\n          \"what_you_are_missing\"\n        ]\n      }\n    }\n  },\n  \"required\": [\n    \"matches\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "={{ $('AI settings').first().json.system_prompt }}"
        }
      },
