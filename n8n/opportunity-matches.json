              "rightValue": "={{ $('Build prompt').first().json.pick_count }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "0f6af6d9-7756-4620-b488-eeed961f6efa",
              "leftValue": "={{ ($json.output?.matches ?? []).filter(m => Number.isInteger(Number(m.candidate)) && Number(m.candidate) >= 1 && Number(m.candidate) <= $('Build prompt').first().json.candidate_count).length }}",
              "rightValue": "={{ $('Build prompt').first().json.pick_count }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "c31c3412-6bd2-41eb-8b36-2f3d88d7b1f4",
              "leftValue": "={{ ($json.output?.matches ?? []).filter(m => String(m.why_you_qualify ?? '').trim().length > 0).length }}",
              "rightValue": "={{ $('Build prompt').first().json.pick_count }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
