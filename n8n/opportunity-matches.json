            {
              "id": "675655fd-9df2-405f-847e-aa8610faa93f",
              "name": "text",
              "value": "=Pick the best {{ $json.pick_count }} of these {{ $json.candidate_count }} opportunities for this student.\n\nStudent profile:\n- University: {{ $('Get profile').first().json.university || 'not given' }}\n- Degree and major: {{ [$('Get profile').first().json.degree, $('Get profile').first().json.major].filter(Boolean).join(', ') || 'not given' }}\n- Year of study: {{ $('Get profile').first().json.study_year || 'not given' }}; graduating {{ $('Get profile').first().json.grad_year || 'not given' }}\n- CGPA (4.0 scale): {{ $('Get profile').first().json.cgpa ? (Number($('Get profile').first().json.cgpa) / Number($('Get profile').first().json.cgpa_scale || 4) * 4).toFixed(2) : 'not given' }}\n- City: {{ $('Get profile').first().json.city || 'not given' }}\n- Skills: {{ ($('Get profile').first().json.skills || []).join(', ') || 'none listed' }}\n- Experience: {{ ($('Get profile').first().json.experience || []).map(e => (e.title || 'Role') + ' at ' + (e.org || 'an organisation')).join('; ') || 'none listed' }}\n\nOpportunities (all of them already pass the eligibility rules):\n{{ $('Get eligible').all().filter(i => i.json.id).slice(0, $('AI settings').first().json.max_candidates).map((i, k) => '[' + (k + 1) + '] ' + i.json.title + ', ' + i.json.organisation + ' (' + String(i.json.kind).replace('_', ' ') + (i.json.industry ? ', ' + i.json.industry : '') + ')' + ' | ' + (i.json.remote ? 'remote' : (i.json.city || 'location not stated')) + ' | deadline ' + (i.json.deadline || 'rolling') + ' | tracks: ' + ((i.json.track_keys || []).join(', ') || 'none') + ' | rules matched: ' + ((i.json.reasons || []).join('; ') || 'open to all') + ' | about: ' + String(i.json.description || 'no description').slice(0, 300)).join('\\n') }}}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
