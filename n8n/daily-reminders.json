{
  "name": "daily-reminders",
  "nodes": [
    {
      "parameters": {
        "content": "## daily-reminders\nEvery day at 9:00 (Pakistan time) emails each student about tracker cards still **Saved** whose deadline is in **3 days** or **1 day**. Sends from the project Gmail. `email_log` stops the same reminder going out twice. No AI, so nothing goes in `ai_runs`.\n\n**After import:** credentials `CC Supabase service` and `CC Gmail`; needs `07_matches_and_emails.sql`; Settings → Error workflow → `cc-error-handler` (once it exists).",
        "height": 260,
        "width": 620,
        "color": 4
      },
      "id": "567ad4fb-a416-4add-8907-71c9cfd4a8f5",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -320
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "bcba3670-acd6-4b1f-8324-eb628537b83d",
      "name": "Every day 9:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        48,
        300
      ],
      "notes": "Runs once a day at 9:00 Asia/Karachi (set in workflow settings)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "09a910ef-4831-4bfa-a28c-331d0d635244",
              "name": "site_url",
              "value": "https://careercoach-pk.vercel.app",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5ab94c68-abf4-4d9e-a231-57f4d680c118",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        288,
        300
      ],
      "notes": "The live site address used in email links (plus model settings where needed)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://hlslkrjuaciplpeplpay.supabase.co/rest/v1/rpc/due_deadline_reminders",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "9f45828b-b05a-47c5-9e51-7fcd3acb659e",
      "name": "Get due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        528,
        300
      ],
      "notes": "Database lists saved cards due in 3 or 1 days, reminders on, not yet emailed",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "do2E3vphY4yosOMR",
          "name": "CC Supabase service"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "f6423970-e0f9-4190-8082-a22ed45ab5df",
              "leftValue": "={{ String($json.application_id ?? '') }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e8d758e2-d9f1-4c20-9251-12c15abf6840",
      "name": "Any due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        768,
        300
      ],
      "notes": "Drops the empty item when nothing is due today",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ea039aa7-aa42-4494-822d-88a450b42b7e",
              "name": "subject",
              "value": "={{ $json.days_left === 1 ? 'Tomorrow: ' + $json.title + ' (' + $json.organisation + ') closes' : '3 days left: ' + $json.title + ' (' + $json.organisation + ')' }}",
              "type": "string"
            },
            {
              "id": "2f4f6f9b-f92f-4b93-987a-5b60debbcbe3",
              "name": "html",
              "value": "=<div style=\"font-family:Arial,sans-serif;font-size:15px;color:#111827;max-width:560px\"><p>Hi {{ String($json.first_name).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }},</p><p>Your saved application <b>{{ String($json.title).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}</b> at <b>{{ String($json.organisation).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}</b> closes on <b>{{ DateTime.fromISO($json.deadline).toFormat('ccc, d LLL yyyy') }}</b> ({{ $json.days_left === 1 ? 'tomorrow' : 'in 3 days' }}).</p>{{ $json.apply_url ? '<p><a href=\"' + $json.apply_url + '\" style=\"background:#15803d;color:#fff;padding:10px 16px;border-radius:6px;text-decoration:none\">Open the application</a></p>' : '' }}<p>When you've applied, move the card to <b>Applied</b> in your <a href=\"{{ $('Settings').first().json.site_url }}/dashboard\">Career Coach tracker</a> and the reminders stop.</p><p style=\"color:#6b7280;font-size:12px;border-top:1px solid #e5e7eb;padding-top:12px;margin-top:24px\">You're getting this because reminders are on for this card. Turn them off on the card or in your profile.</p></div>",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "9e7ec291-4342-4f6f-a4cc-81f879682d27",
      "name": "Write email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1008,
        300
      ],
      "notes": "Writes the subject and a short HTML email for each reminder",
      "notesInFlow": true
    },
    {
      "parameters": {
        "sendTo": "={{ $('Get due reminders').item.json.email }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "senderName": "Career Coach"
        }
      },
      "id": "c5317699-1c78-4ca6-9e94-8f0741926554",
      "name": "Send reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1248,
        300
      ],
      "notes": "Sends from the project Gmail (CC Gmail) to the student",
      "notesInFlow": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "CC Gmail"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "tableId": "email_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "user_id",
              "fieldValue": "={{ $('Get due reminders').item.json.user_id }}"
            },
            {
              "fieldId": "application_id",
              "fieldValue": "={{ $('Get due reminders').item.json.application_id }}"
            },
            {
              "fieldId": "kind",
              "fieldValue": "={{ $('Get due reminders').item.json.kind }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "sent"
            }
          ]
        }
      },
      "id": "bfeaab74-abaf-4bbf-86a5-c995a1de404a",
      "name": "Log sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1488,
        200
      ],
      "notes": "Records the email so this reminder is never sent again",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "do2E3vphY4yosOMR",
          "name": "CC Supabase service"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "tableId": "email_log",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "user_id",
              "fieldValue": "={{ $('Get due reminders').item.json.user_id }}"
            },
            {
              "fieldId": "application_id",
              "fieldValue": "={{ $('Get due reminders').item.json.application_id }}"
            },
            {
              "fieldId": "kind",
              "fieldValue": "={{ $('Get due reminders').item.json.kind }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "failed"
            },
            {
              "fieldId": "error_message",
              "fieldValue": "={{ String($json.error?.message ?? $json.error ?? 'send failed').slice(0, 500) }}"
            }
          ]
        }
      },
      "id": "3c20f059-3860-4c16-ba33-db4384a4af32",
      "name": "Log failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1488,
        420
      ],
      "notes": "Records a failed send for the admin page (it stays due, so the next run tries again)",
      "notesInFlow": true,
      "credentials": {
        "supabaseApi": {
          "id": "do2E3vphY4yosOMR",
          "name": "CC Supabase service"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
