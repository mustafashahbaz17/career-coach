        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"tracks\": {\n      \"type\": \"array\",\n      \"description\": \"Exactly 3 different career tracks from the given list, best fit first\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"track_key\": {\n            \"type\": \"string\",\n            \"description\": \"One of the given track keys, exactly as written\"\n          },\n          \"reason\": {\n            \"type\": \"string\",\n            \"description\": \"At most 2 sentences, specific to this student\"\n          }\n        },\n        \"required\": [\n          \"track_key\",\n          \"reason\"\n        ]\n      }\n    },\n    \"confidence\": {\n      \"type\": \"number\",\n      \"description\": \"How sure you are, from 0 to 1\"\n    },\n    \"followup_questions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"2 short questions if confidence is below 0.6, otherwise empty\"\n    }\n  },\n  \"required\": [\n    \"tracks\",\n    \"confidence\",\n    \"followup_questions\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "={{ $('AI settings').first().json.system_prompt }}"
        }
      },
