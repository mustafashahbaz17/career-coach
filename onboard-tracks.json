              "id": "1c9d5a4f-c26e-455d-be02-bcba4ff36018",
              "name": "text",
              "value": "=Career tracks (key: name — description):\n{{ $('Get tracks').all().filter(i => i.json.key).map(i => '- ' + i.json.key + ': ' + i.json.name + ' — ' + i.json.description).join('\\n') }}\n\nQuiz scores (higher means a stronger fit):\n{{ $('Get scores').all().filter(i => i.json.track_key).sort((a, b) => Number(b.json.score) - Number(a.json.score)).map(i => '- ' + i.json.track_key + ': ' + Number(i.json.score)).join('\\n') }}\n\nProfile:\n- University: {{ $('Get profile').first().json.university || 'not given' }}\n- Degree: {{ $('Get profile').first().json.degree || 'not given' }}\n- Major: {{ $('Get profile').first().json.major || 'not given' }}\n- Year of study: {{ $('Get profile').first().json.study_year || 'not given' }}\n- Skills: {{ ($('Get profile').first().json.skills || []).join(', ') || 'none listed' }}\n- Experience: {{ ($('Get profile').first().json.experience || []).map(e => (e.title || 'Role') + ' at ' + (e.org || 'an organisation')).join('; ') || 'none listed' }}\n\nSomething they're proud of: {{ $('Get answers').all().find(i => i.json.question_id === 'q9')?.json.text_answer || 'not given' }}\nCareers or companies they're curious about: {{ $('Get answers').all().find(i => i.json.question_id === 'q10')?.json.text_answer || 'not given' }}",
              "type": "string"
